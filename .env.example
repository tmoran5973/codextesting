# Copy to .env and enter your key locally. Never commit .env.
COLORING_API_KEY=
PORT=3000
# These are spending reservations you choose, NOT verified provider prices.
IMAGE_RESERVATION_USD=0.50
REVIEW_RESERVATION_USD=0.05
# Required when NODE_ENV=production. Login username is studio.
DEMO_PASSWORD=
# Deployment sets DATA_DIR to persistent storage and HOST to 0.0.0.0.
# Required on Render/Vercel; never commit the server-side Supabase secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
